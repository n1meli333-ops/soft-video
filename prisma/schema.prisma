generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id              String       @id @default(uuid())
  name            String
  templateId      String?
  flowMode        String       @default("image-to-video") // image-to-video, text-to-video

  audioPath       String?
  audioDuration   Float?

  transcriptTxt   String?
  transcriptJson  String?

  prompts         String?      // JSON array of generated prompts
  promptCount     Int          @default(0)

  // Pipeline stage: draft, transcribing, generating_prompts, generating_images, generating_videos, rendering, completed, failed, cancelled
  status          String       @default("draft")
  statusMessage   String?      // Human-readable status message
  progress        Float        @default(0) // 0-100 percentage
  currentStage    String?      // Current pipeline stage name

  outputPath      String?      // Final rendered video path
  errorMessage    String?      // Last error message

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  template        PromptTemplate? @relation(fields: [templateId], references: [id])

  fragments       Fragment[]
  generations     Generation[]
  activities      Activity[]
}

model Fragment {
  id           String   @id @default(uuid())
  projectId    String
  index        Int
  prompt       String
  imagePath    String?   // Generated image path (for image-to-video flow)
  videoPath    String?
  thumbnailPath String?
  duration     Float?
  status       String   @default("pending") // pending, generating_image, generating_video, completed, failed
  errorMessage String?
  retryCount   Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, index])
}

model Generation {
  id            String   @id @default(uuid())
  projectId     String
  status        String   @default("pending") // pending, running, completed, cancelled, failed
  totalFragments Int     @default(0)
  completedFragments Int @default(0)
  duration      Float?
  elapsed       Float?
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PromptTemplate {
  id             String   @id @default(uuid())
  name           String
  stylePrompt    String   @default("")
  negativePrompt String   @default("")
  techPrompt     String   @default("")
  indexFormat     String   @default("")
  isDefault      Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects       Project[]
}

model Activity {
  id          String   @id @default(uuid())
  projectId   String
  type        String   // info, success, error, warning, progress
  stage       String?  // pipeline stage
  message     String
  details     String?  // optional extra info
  progress    Float?   // 0-100

  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
