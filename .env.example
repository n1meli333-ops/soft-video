# Database
DATABASE_URL="file:./data/soft-video.db"

# AssemblyAI (for audio transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_key

# Google Account (for Flow + Gemini Web automation via Playwright)
GOOGLE_EMAIL=your_google_email@gmail.com
# Use an App Password if 2FA is enabled: https://myaccount.google.com/apppasswords
GOOGLE_PASSWORD=your_google_password

# Playwright settings
# Linux: ./data/browser-profile
# Windows: C:\soft-video\data\browser-profile
PLAYWRIGHT_USER_DATA_DIR=./data/browser-profile

# Project data directory
DATA_DIR=./data

# Fragment duration in seconds (default: 8)
FRAGMENT_DURATION=8

# Node environment (development or production)
NODE_ENV=development
